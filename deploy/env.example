# Server config. The Podman example reads it from ~/.config/second-brain/env (chmod 600). See README.

# Public URL of the tunnel hostname (no trailing slash).
PUBLIC_URL=https://brain.example.com

# GitHub OAuth App (github.com/settings/developers):
#   Homepage URL: $PUBLIC_URL   Callback URL: $PUBLIC_URL/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only these GitHub logins or numeric user IDs may use the brain (comma-separated).
# Your ID: curl -s https://api.github.com/users/<login> | grep '"id"'
GITHUB_ALLOWED_USERS=jhoogstraat
# Signs the server's OAuth tokens; keep stable or every client must log in again.
# Generate: openssl rand -hex 32
JWT_SIGNING_KEY=

# Optional static bearer token for CLIs (Codex, Claude Code). Generate: openssl rand -hex 32
BRAIN_TOKEN=

# Optional: push every commit to the brain repo's remote (add the remote in BRAIN_DIR first).
# BRAIN_GIT_PUSH=1
# BRAIN_GIT_NAME=Second Brain
# BRAIN_GIT_EMAIL=brain@localhost
